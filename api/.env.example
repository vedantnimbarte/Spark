DATABASE_URL=postgres://spark:spark@localhost:5432/spark
BIND_ADDR=0.0.0.0:8080
# Base host for generated app URLs: app "blog" -> blog.localhost
APP_BASE_DOMAIN=localhost
# Registry the build job pushes to and the kubelet pulls from.
REGISTRY_URL=localhost:30500
REGISTRY_INSECURE=true
# cert-manager ClusterIssuer for application Ingresses.
# spark-selfsigned locally; spark-letsencrypt (or -staging) on a real cluster.
# Empty disables TLS and serves plain HTTP.
CLUSTER_ISSUER=spark-selfsigned
# Must stay false while the dashboard is served over plain HTTP.
COOKIE_SECURE=false
