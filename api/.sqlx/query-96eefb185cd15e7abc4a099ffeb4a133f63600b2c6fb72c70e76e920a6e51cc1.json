  "query": "SELECT id AS \"id!\",\n                  created_at AS \"created_at!\",\n                  expires_at AS \"expires_at!\",\n                  (token_hash = $2) AS \"current!\"\n           FROM sessions\n           WHERE user_id = $1 AND expires_at > now()\n           ORDER BY created_at DESC",
